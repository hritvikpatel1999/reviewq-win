<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('..\..\packaging\ReviewQ.ico')">..\..\packaging\ReviewQ.ico</ApplicationIcon>
    <AssemblyName>ReviewQ</AssemblyName>
    <RootNamespace>ReviewQ.Windows</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ReviewQ.Core\ReviewQ.Core.csproj" />
    <None Include="..\..\packaging\ReviewQ.ico" Link="ReviewQ.ico" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\packaging\ReviewQ.ico')" />
  </ItemGroup>
</Project>
