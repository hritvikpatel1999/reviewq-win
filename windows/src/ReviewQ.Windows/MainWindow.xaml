<Window x:Class="ReviewQ.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ReviewQ" Width="560" Height="720" MinWidth="420" MinHeight="400"
 WindowStartupLocation="CenterScreen" ThemeMode="System">
 <DockPanel Margin="18">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="ReviewQ" FontSize="26" FontWeight="SemiBold"/>
   <TextBlock Text="Your reviews. One queue." Opacity="0.7" Margin="0,2,0,10"/>
   <WrapPanel>
    <Button Content="_Refresh" Click="RefreshClick" ToolTip="Refresh the queue" Margin="0,0,8,6"/>
    <Button Content="_Settings" Click="SettingsClick" Margin="0,0,8,6"/>
    <Button Content="_Diagnostics" Click="DiagnosticsClick" Margin="0,0,0,6"/>
   </WrapPanel>
   <TextBlock x:Name="StatusText" Margin="0,10" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   <Border x:Name="ErrorPanel" Padding="10" BorderThickness="1" BorderBrush="DarkOrange" Margin="0,0,0,10" Visibility="Collapsed">
    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
   </Border>
  </StackPanel>
  <TextBlock DockPanel.Dock="Bottom" Margin="0,10,0,0" Opacity="0.7" TextWrapping="Wrap" FontSize="11"
   Text="Closing this window keeps ReviewQ in the tray. Use the tray menu to Quit. Windows may hide the tray icon behind overflow."/>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel x:Name="QueuePanel"/>
  </ScrollViewer>
 </DockPanel>
</Window>
