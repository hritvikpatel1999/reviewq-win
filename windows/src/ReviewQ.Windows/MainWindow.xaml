<Window x:Class="ReviewQ.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ReviewQ" Width="560" Height="720" MinWidth="440" MinHeight="400"
 WindowStartupLocation="CenterScreen" ThemeMode="System">
 <DockPanel>
  <StackPanel DockPanel.Dock="Top">
   <Border BorderThickness="0,0,0,1" BorderBrush="#40808080" Padding="18,16">
    <Grid>
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
     </Grid.ColumnDefinitions>
     <ContentControl x:Name="AppSymbol" VerticalAlignment="Center" Margin="0,0,12,0"/>
     <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
      <TextBlock Text="ReviewQ" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock x:Name="StatusText" FontSize="12" Opacity="0.65" Margin="0,2,0,0"
       TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
     </StackPanel>
     <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
      <Button x:Name="SetupButton" Content="_Setup" Click="SetupClick" Style="{StaticResource SetupLinkButton}"
       Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"
       AutomationProperties.Name="Run Setup" ToolTip="Run resumable setup without discarding saved settings"/>
      <Button x:Name="RefreshButton" Click="RefreshClick" Style="{StaticResource ReviewIconButton}" Margin="4,0"
       AutomationProperties.Name="Refresh reviews" ToolTip="Refresh reviews"/>
      <Button x:Name="SettingsButton" Click="SettingsClick" Style="{StaticResource ReviewIconButton}" Margin="4,0"
       AutomationProperties.Name="Settings" ToolTip="Settings (right-click for Diagnostics)">
       <Button.ContextMenu><ContextMenu><MenuItem Header="_Diagnostics..." Click="DiagnosticsClick"/></ContextMenu></Button.ContextMenu>
      </Button>
      <Border Width="1" Height="20" Background="#60808080" Margin="7,0"/>
      <Button x:Name="QuitButton" Click="QuitClick" Style="{StaticResource ReviewIconButton}"
       AutomationProperties.Name="Quit ReviewQ" ToolTip="Quit ReviewQ"/>
     </StackPanel>
    </Grid>
   </Border>
   <Border x:Name="UpdateBanner" Padding="14,8" Margin="12,10,12,0" CornerRadius="8"
    Background="#180A84FF" BorderBrush="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"
    BorderThickness="2,0,0,0" Visibility="Collapsed" AutomationProperties.Name="App update available">
    <DockPanel>
     <Button Content="Dismiss" Click="DismissUpdateClick" DockPanel.Dock="Right" Style="{StaticResource SetupLinkButton}"
      AutomationProperties.Name="Dismiss update for this version"/>
     <Button Content="View Updates" Click="ViewUpdatesClick" DockPanel.Dock="Right" Margin="6,0"
      Style="{StaticResource SetupLinkButton}" AutomationProperties.Name="View Updates"/>
     <TextBlock x:Name="UpdateText" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    </DockPanel>
   </Border>
   <Border x:Name="ErrorPanel" Padding="10" BorderThickness="1" BorderBrush="DarkOrange" Margin="12,10,12,0" Visibility="Collapsed">
    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
   </Border>
  </StackPanel>
  <Border DockPanel.Dock="Bottom" BorderBrush="#40808080" BorderThickness="0,1,0,0" Padding="14,8">
  <Grid>
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="Auto"/>
   </Grid.ColumnDefinitions>
   <TextBlock x:Name="UpdatedText" VerticalAlignment="Center" Margin="0,0,12,0" Opacity="0.75" TextWrapping="Wrap"/>
   <Button Grid.Column="1" Content="By: Hritvik Patel" Click="CreatorClick" HorizontalAlignment="Right"
    Style="{StaticResource SetupLinkButton}" Opacity="0.75" ToolTip="Open Hritvik Patel's GitHub profile"/>
  </Grid>
  </Border>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,14">
   <StackPanel x:Name="QueuePanel" HorizontalAlignment="Stretch"/>
  </ScrollViewer>
 </DockPanel>
</Window>
